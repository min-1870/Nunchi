.venv/
.venv-rocm/
__pycache__/
*.pyc

# corpus downloads and generated datasets (rebuild with nunchi.make_data / make_noise)
data/

# trained models (rebuild with nunchi.train_fasttext / compare / stream_tagger); the registry of names,
# context and tuned thresholds is kept
models/*
!models/registry.json


# experiment logs (each run appends); the analysis and queue scripts kept beside them are code and stay
experiments/logs/*
!experiments/logs/.gitkeep
!experiments/logs/*.py
!experiments/logs/*.sh
# holds pieces of the user's own typing (its relabel table): local only
experiments/logs/my_typing.py

# the app's build output (nunchi.exe goes to GitHub Releases, not the repository)
app/target/
